{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Attention mapping",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "HF_HOME": "/work/tesi_avalenza/hf",
                "HF_HUB_OFFLINE": "1",
            },
            "args": [
                "model=qwen2_5_vl_3b_attn",
                "debug_entity=knife",
                "debug_video_idx=03657401-d4a4-40d0-9b03-d7e093ef93d1"
            ]
        },
        {
            "name": "Current file",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceRoot}:${workspaceRoot}/src",
                "HF_HUB_CACHE": "/leonardo_scratch/large/userexternal/fcocchi0/rag_mlmm/hf_models",
                "HF_HOME": "/leonardo_scratch/large/userexternal/fcocchi0/rag_mlmm/hf_models",
                "HF_DATASETS_CACHE": "/leonardo_scratch/large/userexternal/mmorini0/datasets_cache",
                "TRANSFORMERS_OFFLINE": "1",
                "HF_HUB_OFFLINE": "1",
                "HF_DATASETS_OFFLINE": "1",
                "PYDEVD_WARN_SLOW_RESOLVE_TIMEOUT": "2",
                "HF_ENABLE_PARALLEL_LOADING": "true",
                "PART": "0",
                "TOTAL_PART": "0",
            },
            "args": [
                "--model_name", "Qwen/Qwen2.5-VL-3B-Instruct",
                "--dataset", "mvbench",
                "--nframes", "16"
            ]
        }
    ]
}