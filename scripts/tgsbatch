#!/bin/bash
# Rimpiazzo trasparente di `sbatch` che apre il messaggio Telegram 🕓 PENDING
# per la sottomissione. Da qui in poi il messaggio lo aggiorna
# `scripts/lib/notify.sh` dal nodo di calcolo (RUNNING → esito + metriche).
#
#   scripts/tgsbatch scripts/sbatch/video_mme.sbatch
#   scripts/tgsbatch --time=02:00:00 scripts/sbatch/video_mme-test.sbatch limit=10
#
# Senza bot configurato è un `exec sbatch "$@"`: stessi argomenti, stesso
# output, stesso exit code. Anche con il bot attivo, l'output resta quello di
# `sbatch` ("Submitted batch job N") perché i launcher esistenti se lo aspettano.
set -uo pipefail

_here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/notify.sh
source "$_here/lib/notify.sh"

tg_enabled || exec sbatch "$@"

out=$(sbatch --parsable "$@")
rc=$?
if [[ $rc -ne 0 ]]; then
    [[ -n "$out" ]] && printf '%s\n' "$out"
    exit $rc
fi

# `--parsable` stampa "jobid" oppure "jobid;cluster".
jobid=${out%%;*}
jobid=${jobid//[!0-9]/}
if [[ -z "$jobid" ]]; then
    printf '%s\n' "$out"
    exit 0
fi

# Nome e dimensione dell'array li sa SLURM, non la riga di comando (possono
# venire dalle direttive #SBATCH del file o da un override sulla CLI).
info=$(scontrol show job "$jobid" 2>/dev/null) || true
name=$(printf '%s' "$info" | tr ' ' '\n' | sed -n 's/^JobName=//p' | head -1)
array=$(printf '%s' "$info" | tr ' ' '\n' | sed -n 's/^ArrayTaskId=//p' | head -1)

# Espande "0-2", "0-8%2", "1,3,5" nel numero di task. Serve solo al conteggio
# "conclusi n/N" del riepilogo, quindi in caso di formato inatteso si degrada
# a "?" invece di sbagliare il totale.
total=1
if [[ -n "$array" ]]; then
    total=0
    IFS=',' read -ra _parts <<< "${array%%\%*}"
    for p in "${_parts[@]}"; do
        p=${p%%\%*}
        if [[ "$p" =~ ^([0-9]+)-([0-9]+)$ ]]; then
            total=$(( total + BASH_REMATCH[2] - BASH_REMATCH[1] + 1 ))
        elif [[ "$p" =~ ^[0-9]+$ ]]; then
            total=$(( total + 1 ))
        else
            total='?'; break
        fi
    done
fi

dir="$TG_STATE_DIR/$jobid"
mkdir -p "$dir" 2>/dev/null || true
# Lo stato serve solo finché il job è vivo; senza potatura la home (che su HPC
# ha una quota) accumulerebbe una directory per sottomissione all'infinito.
find "$TG_STATE_DIR" -mindepth 1 -maxdepth 1 -type d -mtime +30 -exec rm -rf {} + 2>/dev/null || true
date +%s > "$dir/submit.ts" 2>/dev/null || true
printf '%s' "$total" > "$dir/total" 2>/dev/null || true

text="🕓 <b>PENDING</b> · $(printf '%s' "${name:-job} · ${jobid}${array:+ [$array]}" | tg_escape)
$(printf '%s' "$*" | tg_escape)"
printf '%s' "$text" > "$dir/submit.text" 2>/dev/null || true
tg_send "$text" > "$dir/submit.msgid" 2>/dev/null || true

printf 'Submitted batch job %s\n' "$jobid"
